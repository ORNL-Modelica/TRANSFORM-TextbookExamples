within TRANSFORMTextbookExamples;
package Cleynen_EngineeringThermodynamics
  "Worked examples from Cleynen, Engineering Thermodynamics (2025)"
  extends Modelica.Icons.ExamplesPackage;

  annotation (Documentation(info="<html>
<p>Worked examples from Olivier Cleynen, <i>Engineering Thermodynamics</i>, International
edition with SI units (2025), available free from
<a href=\"https://thermodynamicsbook.com/\">thermodynamicsbook.com</a>. Each model's
documentation gives the example number and page.</p>
<p>Only the examples' numerical data and published answers are used. The book reads water
properties from printed steam tables; TRANSFORM computes them with IAPWS-IF97, so results
can differ from the book's answers by small amounts.</p>
</html>"));
end Cleynen_EngineeringThermodynamics;
